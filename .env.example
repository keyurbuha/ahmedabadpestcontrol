# Node.js 24+. Keep uploaded images on persistent disk and back them up.
DATA_DIR=./storage
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ahmedabad_pest_control
APP_ORIGIN=http://localhost:3000
# Enable only behind a local reverse proxy that overwrites X-Real-IP.
TRUST_LOCAL_PROXY=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
